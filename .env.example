# Configure apenas no servidor (Vercel > Settings > Environment Variables).
# Places API (New); requer projeto Google Cloud com faturamento configurado.
GOOGLE_MAPS_API_KEY=
# Descoberta de páginas B2C. A página precisa permitir leitura pública HTML.
SERPER_API_KEY=
PORT=3000

# Nome antigo da chave Google também é aceito; não é preciso duplicá-la.
# CHAVE_API_DO_GOOGLE_MAPS=
# Comentários sociais: três Actors públicos, com limite por execução.
APIFY_API_TOKEN=
# Opcional: links de origem separados por vírgula; não inclua cookies/sessões.
BLITZ_PUBLIC_SOCIAL_URLS=
# Cadastro empresarial por CNPJ exato; conta com saldo próprio.
CASA_DOS_DADOS_API_KEY=

# Custo máximo por Actor (até cinco Actors por busca, incluindo marketplaces).
BLITZ_APIFY_MAX_USD_PER_RUN=0.5
# Opcional: limitar as contas que podem usar as fontes pagas (UIDs separados por vírgula).
BLITZ_ALLOWED_UIDS=

# Radar econômico: sem estes limites explícitos, nenhuma API paga é chamada.
# Credencial JSON Firebase Admin, SOMENTE no servidor; nunca VITE_ nem no Git.
BLITZ_FIREBASE_SERVICE_ACCOUNT=
# Hosts públicos autorizados pelo operador após revisar permissão/robots (separados por vírgula).
BLITZ_PUBLIC_ALLOWED_HOSTS=
# Limites monetários USD por busca e por dia (dia America/Sao_Paulo).
BLITZ_RADAR_SEARCH_USD=
BLITZ_RADAR_DAILY_USD=
# Estimativa conservadora de custo por consulta conforme seu contrato Serper; saldo não verificado.
BLITZ_SERPER_QUERY_USD=
BLITZ_RADAR_SERPER_QUERIES=
BLITZ_RADAR_DAILY_SERPER_QUERIES=
# Quantidade de runs por busca (máximo 5) e concorrência global.
BLITZ_RADAR_MAX_ACTORS=
BLITZ_RADAR_CONCURRENCY=
BLITZ_RADAR_ACTOR_CONCURRENCY=
# Cache por instância: 60 a 3600 segundos. Execuções pagas também persistem no Firestore.
BLITZ_RADAR_CACHE_SECONDS=900
BLITZ_RADAR_MAX_AGE_DAYS=30
