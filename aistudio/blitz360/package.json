{
  "name": "blitz-360-pro",
  "private": true,
  "version": "2.0.0",
  "description": "Plataforma avan\u00e7ada de intelig\u00eancia comercial, prospec\u00e7\u00e3o de vendas B2B/B2C, OSINT corporativo e extra\u00e7\u00e3o de contatos.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "vite build --outDir dist/public && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "NODE_ENV=production node dist/server.js",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
